{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-ai.invalid/schemas/knowledge-record.schema.json",
  "title": "QUANTUM AI Knowledge Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "language",
    "content",
    "sources",
    "evidence_type",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string"
    },
    "subdomain": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "hi",
        "mul"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "publisher"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "license": {
            "type": "string"
          },
          "section_or_page": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "primary",
        "official_reference",
        "peer_reviewed",
        "textbook",
        "secondary",
        "tertiary"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "source_checked",
        "expert_reviewed",
        "disputed",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "date_sensitive": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
