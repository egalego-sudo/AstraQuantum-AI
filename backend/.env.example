# Keep secret values empty in this template. Set real values only in a private secret store.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

PORT=8080
# Comma-separated exact browser origins. Keep empty for the native Android app.
# Do not use *; CORS is not authentication.
ALLOWED_ORIGINS=
# Required for all private API routes. Generate a long random value outside this file.
APP_ACCESS_TOKEN=
API_MAX_REQUESTS_PER_MINUTE=20
GROQ_MAX_INPUT_BYTES=7000
GROQ_TPM_LIMIT=8000

# Optional IBM Quantum integration. Keep credentials empty and submissions disabled by default.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_SERVICE_CRN=
IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com
IBM_QUANTUM_SUBMISSIONS_ENABLED=false
