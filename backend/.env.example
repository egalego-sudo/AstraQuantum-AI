# Store real credentials only in the hosting provider's secret manager.
GROQ_API_KEY=replace_with_secret_in_host_secret_manager
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

PORT=8080
# Comma-separated exact browser origins. Keep empty for the native Android app.
# Never use * as an authentication or access-control mechanism.
ALLOWED_ORIGINS=
# Required for all private API routes; use a long random value in the host secret store.
APP_ACCESS_TOKEN=replace_with_long_random_secret_in_host_secret_manager
API_MAX_REQUESTS_PER_MINUTE=20
GROQ_MAX_INPUT_BYTES=7000
GROQ_TPM_LIMIT=8000

# Optional IBM Quantum integration. Keep disabled unless explicitly configured.
IBM_QUANTUM_API_KEY=store_only_in_render_secret_environment
IBM_QUANTUM_SERVICE_CRN=your_quantum_instance_crn
IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com
IBM_QUANTUM_SUBMISSIONS_ENABLED=false
